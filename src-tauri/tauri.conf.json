{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repovela",
  "version": "0.1.0",
  "identifier": "io.github.proladon.repovela",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Repovela",
      "decorations": false,
      "shadow": true,
      "width": 1360,
      "height": 880,
      "minWidth": 1000,
      "minHeight": 640,
      "backgroundColor": "#111318"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
