{
  "name": "repovela",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src e2e *.json *.ts index.html",
    "tauri": "tauri",
    "test:visual": "playwright test",
    "test:flow": "playwright test --grep \"畫面與完整瀏覽流程\" --ignore-snapshots",
    "test:windows": "playwright test --config playwright.windows.config.ts",
    "validate:windows": "pnpm test && pnpm run tauri build --no-bundle && pnpm run test:windows",
    "validation:fixtures": "node --experimental-strip-types scripts/validation-fixtures.ts"
  },
  "dependencies": {
    "@shikijs/markdown-it": "^4.5.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.5.0",
    "vue": "^3.5.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
